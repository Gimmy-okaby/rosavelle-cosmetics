# ========================================================
# Rosavelle Cosmetics - Environment Variables Template
# ========================================================
# Copy this file to '.env.local' and add your Supabase project credentials.
# Get these values from: https://supabase.com -> Project Settings -> API

# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=

# Supabase Anonymous Public Key (safe to use in frontend with RLS)
# DO NOT USE SERVICE_ROLE KEY HERE!
VITE_SUPABASE_ANON_KEY=

# Optional Store Owner Configuration
VITE_STORE_NAME_AR=روزافيل كوزمتكس
VITE_STORE_NAME_EN=Rosavelle Cosmetics
VITE_DEFAULT_CURRENCY=EGP
